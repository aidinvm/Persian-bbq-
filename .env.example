# ============================================
# Weekend Backyard BBQ — Environment Variables
# ============================================
# Copy this file to .env.local for local development
# and set these in Vercel Project Settings > Environment Variables.

# 1. Database (Neon Postgres via Vercel Storage or Supabase)
# Leave blank locally to use the automatic file-based dev store (.data/dev-store.json).
# REQUIRED in production on Vercel.
DATABASE_URL=

# 2. Public App URL (used for Stripe Checkout return URLs)
# Locally: http://localhost:3000
# Production: https://your-domain.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 3. Stripe Payments (Primary Payment Gateway)
# Get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_replace_me
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
# Get from Stripe Dashboard > Developers > Webhooks > Add endpoint:
#   URL: https://your-domain.vercel.app/api/webhooks/stripe
#   Events: checkout.session.completed, checkout.session.expired
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# 4. Admin Back Panel Authentication (No Firebase!)
ADMIN_EMAIL=weekendbackyardbbq@gmail.com
ADMIN_PASSWORD=change-this-strong-password
# Generate a random 32+ char string: openssl rand -hex 32
SESSION_SECRET=change-this-to-a-long-random-secret-key-min-32-chars

# 5. Email Notifications (Gmail SMTP using Google App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=weekendbackyardbbq@gmail.com
SMTP_PASS=your-16-char-gmail-app-password
OWNER_NOTIFICATION_EMAIL=weekendbackyardbbq@gmail.com
